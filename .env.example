# CampaignBrain - Environment Variables
# Copy this file to .env and fill in your API keys

# Required - OpenAI (GPT-3.5 / GPT-4 for agents)
OPENAI_API_KEY=your_openai_api_key_here

# Optional - Alpha Vantage (real financial data for /demo/company/{ticker})
# Get free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Optional - NewsAPI (real news for sentiment analysis)
# Get free key at: https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here
